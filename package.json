{
  "name": "energo-registry-rf",
  "version": "1.2.0",
  "private": true,
  "description": "Реестр энергогенерирующих и энергоремонтных предприятий РФ: веб-приложение, карта, печатная версия",
  "scripts": {
    "build": "node build.js",
    "collect": "node scripts/collect-tenders.js",
    "collect:probe": "node scripts/collect-tenders.js --probe-only",
    "collect:direct": "node scripts/collect-tenders.js --source=tektorg-direct,etpgpb-direct,roseltorg-direct",
    "test:direct": "node scripts/test-direct.js",
    "test:theme": "node scripts/test-theme.js",
    "compare:direct": "node scripts/compare-direct.js",
    "keywords": "node scripts/keywords.js",
    "test": "node prototype/test-regressions.js",
    "test:collect": "node scripts/test-collect.js",
    "test:worker": "node worker/test-worker.mjs",
    "deploy:worker": "powershell -ExecutionPolicy Bypass -File scripts/deploy-worker.ps1",
    "dry-run": "node scripts/collect-tenders.js --dry-run",
    "stats:keywords": "node scripts/keyword-stats.js",
    "probe": "node scripts/probe-one.js",
    "archive:restore": "node scripts/archive.js restore",
    "archive:snapshot": "node scripts/archive.js snapshot",
    "archive:prune": "node scripts/archive.js prune",
    "validate": "node scripts/validate-entities.js",
    "check:release": "node scripts/check-release.js",
    "verify:inn": "node scripts/verify-contacts.js",
    "serve": "python -m http.server 8765 --bind 127.0.0.1",
    "start": "node build.js && python -m http.server 8765 --bind 127.0.0.1"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  }
}
